# Copy to .env.local and fill in. Never commit .env.local.

# Required for the text lane (free-text PII detection) and AI column-role suggestions.
MASKING_ANTHROPIC_API_KEY=

# GPU services for the photo and PDF lanes. Leave empty to use the team's default servers.
OCR_API_URL=
PRIVACY_FILTER_URL=
FACE_API_URL=
FACE_REPAINT_URL=

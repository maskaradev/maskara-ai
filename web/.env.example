# Copy to .env.local and fill in. Never commit .env.local.

# The prototype app (app.<domain>) and its API routes, which send uploads to the Anthropic API and the GPU
# services below, only run under `next dev`. Any other build, Vercel previews included, redirects the app to
# the landing page unless this is set to 1. Leave it unset on the public deployment.
MASKARA_HOSTED_APP=

# Required for the text lane (free-text PII detection) and AI column-role suggestions.
MASKING_ANTHROPIC_API_KEY=

# GPU services for the photo and PDF lanes. Leave empty to use the default servers.
OCR_API_URL=
PRIVACY_FILTER_URL=
FACE_API_URL=
FACE_REPAINT_URL=

# Where the landing page's team/on-prem waitlist sends each signup, as a JSON POST: { text, email, company,
# useCase, submittedAt }. Anything that accepts a webhook works: a Slack incoming webhook (posts `text`),
# a Google Apps Script web app, Zapier, Make. Server-side only. Unset in development, signups are logged
# to the console; unset in production, the form reports that the waitlist is unavailable.
WAITLIST_WEBHOOK_URL=

# Landing page and app share one deployment: the apex domain serves the landing page and app.<domain> the app
# (see src/proxy.ts). Default: maskara.dev.
NEXT_PUBLIC_ROOT_DOMAIN=
